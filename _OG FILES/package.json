{
  "name": "aera-technology-theme",
  "version": "1.0.0",
  "description": "Production WordPress theme for Aera Technology.",
  "author": "Aera Technology",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "WordPress",
    "Theme",
    "Aera Technology"
  ],
  "homepage": "https://www.aeratechnology.com",
  "devDependencies": {
    "@wordpress/scripts": "^19.2.2",
    "concurrently": "^8.2.2",
    "dir-archiver": "^1.1.1",
    "rtlcss": "^3.5.0",
    "sass": "^1.80.2",
    "vite": "^5.1.0"
  },
  "dependencies": {
    "contentful-management": "^11.67.2",
    "gsap": "^3.12.2",
    "three": "^0.122.0"
  },
  "optionalDependencies": {
    "marked": "^7.0.5",
    "striptags": "^3.2.0"
  },
  "rtlcssConfig": {
    "options": {
      "autoRename": false,
      "autoRenameStrict": false,
      "blacklist": {},
      "clean": true,
      "greedy": false,
      "processUrls": false,
      "stringMap": []
    },
    "plugins": [],
    "map": false
  },
  "scripts": {
    "clean:dsstore": "find . -name .DS_Store -type f -delete",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:js\" \"npm run dev:scripts\" --names \"SASS,BG,JS\" --prefix-colors \"cyan,green,yellow\"",
    "dev:css": "sass --watch sass/aera.scss:assets/css/aera.css --style=expanded --embed-source-map",
    "dev:js": "vite build --watch --mode development --config vite.config.js",
    "dev:scripts": "vite build --watch --mode development --config vite.config.scripts.js",
    "build": "npm run clean:dsstore && npm run build:css && npm run build:js && npm run build:scripts",
    "build:prod": "npm run clean:dsstore && npm run build:css && npm run build:js && npm run build:scripts",
    "build:css": "sass sass/aera.scss:assets/css/aera.css --style=compressed --no-source-map",
    "build:js": "vite build --mode production --config vite.config.js",
    "build:scripts": "vite build --mode production --config vite.config.scripts.js",
    "watch": "concurrently \"npm run watch:css\" \"npm run watch:js\" \"npm run watch:scripts\" --names \"SASS,BG,JS\" --prefix-colors \"cyan,green,yellow\"",
    "watch:css": "sass --watch sass/aera.scss:assets/css/aera.css --style=expanded --embed-source-map",
    "watch:js": "vite build --watch --mode development --config vite.config.js",
    "watch:scripts": "vite build --watch --mode development --config vite.config.scripts.js",
    "compile:css": "sass sass/aera.scss:assets/css/aera.css && stylelint 'assets/css/*.css' --fix || true && stylelint 'assets/css/*.css' --fix",
    "compile:rtl": "rtlcss assets/css/aera.css assets/css/aera-rtl.css",
    "lint:scss": "wp-scripts lint-style 'sass/**/*.scss'",
    "lint:js": "wp-scripts lint-js 'js/*.js'",
    "bundle": "dir-archiver --src . --dest ../aera-technology.zip --exclude .DS_Store .stylelintrc.json .eslintrc .git .gitattributes .github .gitignore README.md composer.json composer.lock node_modules vendor package-lock.json package.json .travis.yml phpcs.xml.dist sass style.css.map yarn.lock",
    "build:background": "vite build --config vite.config.js",
    "watch:background": "vite build --watch --mode development --config vite.config.js"
  }
}