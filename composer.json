{
  "name": "maxharrisnet/starter-coat",
  "type": "wordpress-theme",
  "description": "ACF-first component and section-based WordPress theme foundation.",
  "keywords": [
    "WordPress",
    "Themes"
  ],
  "homepage": "https://github.com/maxharrisnet/starter",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Max Harris",
      "homepage": "https://maxharris.net/"
    }
  ],
  "require": {
    "php": ">=5.6"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
    "wptrt/wpthemereview": "^0.2.1",
    "php-parallel-lint/php-parallel-lint": "^1.2.0",
    "wp-cli/i18n-command": "^2.2.5"
  },
  "scripts": {
    "lint:wpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
    "lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor .",
    "make-pot": "wp i18n make-pot . languages/starter-coat.pot"
  },
  "support": {
    "issues": "https://github.com/maxharrisnet/starter/issues",
    "source": "https://github.com/maxharrisnet/starter"
  }
}